generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  DELETING
}
enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}
model User {
  id        String @id @default(uuid()) @db.Uuid
  email     String @unique
  passwordHash String @default("!disabled")
  createdAt DateTime @default(now())
  accounts  Account[]
  sessions  Session[]
  documents Document[]
}
model Account {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @db.Uuid
  provider          String
  providerAccountId String
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}
model Session {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
model Document {
  id          String @id @default(uuid()) @db.Uuid
  ownerId     String @db.Uuid
  storageKey  String @unique
  filename    String
  mediaType   String
  sizeBytes   BigInt
  status      DocumentStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chunks      DocumentChunk[]
  jobs        ProcessingJob[]
  @@unique([id, ownerId])
  @@index([ownerId, createdAt])
}
model ProcessingJob {
  id          String @id @default(uuid()) @db.Uuid
  documentId  String @db.Uuid
  ownerId     String @db.Uuid
  pipelineVersion String
  status      JobStatus @default(PENDING)
  attempts    Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil  DateTime?
  errorCode   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  document    Document @relation(fields: [documentId, ownerId], references: [id, ownerId], onDelete: Cascade)
  @@unique([documentId, pipelineVersion])
  @@index([status, availableAt])
  @@index([ownerId, documentId])
}
model DocumentChunk {
  id          String @id @default(uuid()) @db.Uuid
  documentId  String @db.Uuid
  ownerId     String @db.Uuid
  pipelineVersion String
  ordinal     Int
  text        String
  pageNumber  Int?
  createdAt   DateTime @default(now())
  document    Document @relation(fields: [documentId, ownerId], references: [id, ownerId], onDelete: Cascade)
  embeddings  Embedding[]
  @@unique([documentId, pipelineVersion, ordinal])
  @@unique([id, ownerId])
  @@index([ownerId, documentId])
}
model Embedding {
  id         String @id @default(uuid()) @db.Uuid
  chunkId    String @db.Uuid
  ownerId    String @db.Uuid
  provider   String
  model      String
  dimensions Int
  vector     Unsupported("vector")
  createdAt  DateTime @default(now())
  chunk      DocumentChunk @relation(fields: [chunkId, ownerId], references: [id, ownerId], onDelete: Cascade)
  @@unique([chunkId, provider, model])
  @@index([ownerId, chunkId])
}

model RateBucket {
 key String @id
 count Int
 expiresAt DateTime
 @@index([expiresAt])
}
