# Prefer npm run db:setup to generate a private .env with random credentials.
# Manual setup only: replace all three matching password placeholders.
NODE_ENV=development
POSTGRES_USER=retrivra
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=retrivra
DATABASE_URL=postgresql://retrivra:local-development-only@127.0.0.1:5432/retrivra?connect_timeout=3
TEST_DATABASE_ADMIN_URL=postgresql://retrivra:local-development-only@127.0.0.1:5432/postgres
STORAGE_ROOT=./var/storage
# Local Ollama only; disabled is also accepted.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
GENERATION_MODEL=qwen2.5:3b
CHUNK_SIZE=1400
CHUNK_OVERLAP=200
# Generate AUTH_SECRET locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Only for the isolated Compose database network; use verify-full TLS elsewhere.
DATABASE_TLS_INTERNAL=false
